---
import { getLangFromUrl, t } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const features = lang === 'zh'
  ? [
      {
        title: '项目卡片',
        desc: '一个面板管理所有项目。点一下卡片主体二次确认即启动；Launch ▸ 直接拉起。',
        icon: 'M4 6h16M4 12h16M4 18h16',
      },
      {
        title: 'Agent 绑定',
        desc: '每个项目绑定一个 agent，termana 解析启动命令。built-in 预设不可改不可删，自定义 agent 随意增删。',
        icon: 'M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z',
      },
      {
        title: '一键启动',
        desc: '启动 = 开系统终端、cd 进目录、跑绑定的 agent。macOS 用 Terminal.app，Windows 用 PowerShell。',
        icon: 'M5 3l14 9-14 9V3z',
      },
      {
        title: '安装检测',
        desc: '在用户实际用的 login shell 里查 agent，fnm / nvm / asdf / volta 的 rc 设置也生效，只认外部命令。',
        icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
      },
      {
        title: 'AGENTS.md 编辑器',
        desc: '编辑 / 预览 tab，marked 渲染 markdown。文件即正本，无同步、无 drift、无「Generated by」污染。',
        icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.4-9.4a2 2 0 112.8 2.8L11 18l-4 1 1-4 9.6-9.6z',
      },
      {
        title: 'CLAUDE.md 指针',
        desc: '缺失时自动建好 @AGENTS.md 指针并告知；已有独立内容先确认再转换，symlink 不写穿。',
        icon: 'M10 13a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1M14 11a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1',
      },
      {
        title: '启动组',
        desc: '把多个项目组成一组，Launch all 一键全开，每个项目各开一个终端。',
        icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V7a2 2 0 00-2-2H7a2 2 0 00-2 2v4',
      },
      {
        title: '本地优先',
        desc: '无账号、无云、无服务。配置是磁盘上的 TOML 文件，迁移机器 / 换人即带走。',
        icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
      },
    ]
  : [
      {
        title: 'Project cards',
        desc: 'Manage every project in one panel. Click the card body to confirm-and-launch, or hit Launch ▸ directly.',
        icon: 'M4 6h16M4 12h16M4 18h16',
      },
      {
        title: 'Agent binding',
        desc: 'Bind an agent per project; termana resolves the launch command. Built-in presets are locked; custom agents are free to add.',
        icon: 'M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z',
      },
      {
        title: 'One-click launch',
        desc: 'Launch = open system terminal, cd into the project, run the bound agent. macOS via Terminal.app, Windows via PowerShell.',
        icon: 'M5 3l14 9-14 9V3z',
      },
      {
        title: 'Install detection',
        desc: 'Detects agents in your actual login shell — fnm / nvm / asdf / volta setups all work. Only real external commands count.',
        icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
      },
      {
        title: 'AGENTS.md editor',
        desc: 'Edit / preview tabs with markdown rendering. The file is the source of truth — no sync, no drift, no "Generated by" pollution.',
        icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.4-9.4a2 2 0 112.8 2.8L11 18l-4 1 1-4 9.6-9.6z',
      },
      {
        title: 'CLAUDE.md pointer',
        desc: 'Auto-creates an @AGENTS.md pointer when missing and tells you; confirms before converting existing content; never writes through symlinks.',
        icon: 'M10 13a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1M14 11a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1',
      },
      {
        title: 'Launch groups',
        desc: 'Group projects and Launch all — each project opens its own terminal in one shot.',
        icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V7a2 2 0 00-2-2H7a2 2 0 00-2 2v4',
      },
      {
        title: 'Local-first',
        desc: 'No account, no cloud, no server. Config is a TOML file on disk — move machines or hand off by copying the file.',
        icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
      },
    ];
---

<section id="features" class="section">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">{lang === 'zh' ? '核心能力' : 'Capabilities'}</p>
      <h2 class="mt-3 h2">{t(lang, 'features.title')}</h2>
      <p class="mt-4 lead">{t(lang, 'features.subtitle')}</p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((f) => (
        <div class="card">
          <div class="grid h-10 w-10 place-items-center rounded-lg bg-accent/10 text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={f.icon}/></svg>
          </div>
          <h3 class="mt-4 text-base font-semibold text-white">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-400">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
