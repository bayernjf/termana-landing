---
import { getLangFromUrl, t } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);

const isZh = lang === 'zh';
const cols = isZh
  ? ['维度', '各 agent 自带工具', 'termana']
  : ['Dimension', 'Per-agent vendor tools', 'termana'];
const rows = isZh
  ? [
      ['多项目集中管理', '✗ 各自分散', '✓ 一个面板管所有项目'],
      ['跨 agent 中立', '✗ 只管自家', '✓ 不属于任何厂商'],
      ['一键启动 + cd', '✗ 手动开终端', '✓ 自动开终端、cd、跑 agent'],
      ['AGENTS.md 编辑', '部分支持', '✓ 编辑器 + 预览 + 指针'],
      ['安装检测', '✗', '✓ login shell 检测'],
      ['本地优先 / 无账号', '看厂商', '✓ 纯本地 TOML'],
      ['迁移 / 换机', '✗', '✓ 复制配置文件'],
    ]
  : [
      ['Multi-project hub', '✗ scattered', '✓ one panel for all'],
      ['Agent-neutral', '✗ vendor-locked', '✓ belongs to no vendor'],
      ['1-click launch + cd', '✗ manual terminal', '✓ auto open, cd, run agent'],
      ['AGENTS.md editing', 'partial', '✓ editor + preview + pointer'],
      ['Install detection', '✗', '✓ login-shell aware'],
      ['Local-first / no account', 'varies', '✓ pure local TOML'],
      ['Migrate / new machine', '✗', '✓ copy one file'],
    ];
---

<section id="compare" class="section bg-ink-900/30">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">{isZh ? '对比' : 'Compare'}</p>
      <h2 class="mt-3 h2">{t(lang, 'compare.title')}</h2>
      <p class="mt-4 lead">{t(lang, 'compare.subtitle')}</p>
    </div>

    <div class="mt-12 overflow-x-auto">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-ink-700">
            {cols.map((c, i) => (
              <th class={`px-4 py-3 font-semibold ${i === cols.length - 1 ? 'text-accent' : 'text-ink-200'}`}>{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-ink-800/70">
              {row.map((cell, i) => (
                <td class={`px-4 py-3 ${i === 0 ? 'font-medium text-ink-100' : i === row.length - 1 ? 'text-accent' : 'text-ink-400'}`}>
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
