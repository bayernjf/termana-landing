---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import StarOnGithub from '@bay/landing-ui/components/StarOnGithub.astro';
import { getLangFromUrl, t, langPrefix } from '../i18n/ui';
import { SITE } from '../i18n/site';

const lang = getLangFromUrl(Astro.url);
const year = new Date().getFullYear();
const home = lang === 'en' ? '/' : '/zh';
const prefix = langPrefix(lang);

const cols = [
  {
    title: t(lang, 'footer.product'),
    links: [
      { label: t(lang, 'nav.features'), href: '#features' },
      { label: t(lang, 'nav.compare'), href: '#compare' },
      { label: t(lang, 'nav.download'), href: '#download' },
      { label: t(lang, 'nav.roadmap'), href: '#roadmap' },
    ],
  },
  {
    title: t(lang, 'footer.resources'),
    links: [
      { label: t(lang, 'nav.docs'), href: SITE.docs },
      { label: t(lang, 'nav.faq'), href: '#faq' },
      { label: 'Changelog', href: SITE.changelog },
      { label: 'BayJF', href: 'https://bayjf.com' },
      { label: 'GitHub', href: SITE.repo },
    ],
  },
  {
    title: t(lang, 'footer.legal'),
    links: [
      { label: t(lang, 'footer.privacy'), href: `${prefix}/privacy` },
      { label: t(lang, 'footer.terms'), href: `${prefix}/terms` },
    ],
  },
];
---

<footer class="border-t border-ink-800 bg-ink-950">
  <div class="container-page py-14">
    <div class="grid gap-10 md:grid-cols-5">
      <div class="md:col-span-2">
        <a href={home} class="flex items-center gap-2 font-bold text-white">
          <svg viewBox="0 0 32 32" class="h-7 w-7" aria-hidden="true">
            <rect width="32" height="32" rx="7" fill="#0c1219" />
            <rect x="3" y="3" width="26" height="26" rx="5" fill="none" stroke="#5fd1c5" stroke-width="1.5" opacity="0.4" />
            <text x="10" y="21" font-family="ui-monospace, Menlo, monospace" font-size="16" font-weight="700" fill="#5fd1c5">&gt;</text>
            <rect x="16" y="17" width="6" height="2" fill="#5fd1c5" rx="1" />
          </svg>
          <span>termana</span>
        </a>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-400">{t(lang, 'footer.tagline')}</p>
      </div>
      {cols.map((col) => (
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-300">{col.title}</h3>
          <ul class="mt-3 space-y-2">
            {col.links.map((link) => (
              <li>
                {link.href === 'https://bayjf.com' ? (
                  <BayjfLink size={16} class="text-sm text-ink-400 transition hover:text-accent" label={link.label} />
                ) : link.href === SITE.repo ? (
                  <StarOnGithub href={SITE.repo} size={14} class="text-ink-400" />
                ) : (
                  <a href={link.href} class="text-sm text-ink-400 transition hover:text-accent">
                    {link.label}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-ink-800 pt-6 text-xs text-ink-500 sm:flex-row sm:items-center">
      <p>&copy; {year} termana. {t(lang, 'footer.copyright')}</p>
      <p class="font-mono">v1 · local-first · agent-neutral</p>
    </div>
  </div>
</footer>
