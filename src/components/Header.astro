---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import { getLangFromUrl, t } from '../i18n/ui';
import { SITE } from '../i18n/site';

const lang = getLangFromUrl(Astro.url);
const otherLang = lang === 'en' ? 'zh' : 'en';
const otherHref = lang === 'en' ? '/zh' : '/';
const otherLabel = lang === 'en' ? '中文' : 'EN';

const navItems = [
  { href: '#features', key: 'nav.features' as const },
  { href: '#compare', key: 'nav.compare' as const },
  { href: '#context', key: 'nav.context' as const },
  { href: '#download', key: 'nav.download' as const },
  { href: '#faq', key: 'nav.faq' as const },
  { href: '#roadmap', key: 'nav.roadmap' as const },
];
---

<header class="sticky top-0 z-40 border-b border-ink-800/60 bg-ink-950/80 backdrop-blur-xl">
  <div class="container-page flex h-14 items-center justify-between sm:h-16">
    <a href={lang === 'en' ? '/' : '/zh'} class="flex items-center gap-2 font-bold text-white">
      <svg viewBox="0 0 32 32" class="h-7 w-7" aria-hidden="true">
        <rect width="32" height="32" rx="7" fill="#0c1219" />
        <rect x="3" y="3" width="26" height="26" rx="5" fill="none" stroke="#5fd1c5" stroke-width="1.5" opacity="0.4" />
        <text x="10" y="21" font-family="ui-monospace, Menlo, monospace" font-size="16" font-weight="700" fill="#5fd1c5">&gt;</text>
        <rect x="16" y="17" width="6" height="2" fill="#5fd1c5" rx="1" />
      </svg>
      <span class="text-base tracking-tight">termana</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex">
      {navItems.map((item) => (
        <a href={item.href} class="text-sm text-ink-300 transition hover:text-white">
          {t(lang, item.key)}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={otherHref}
        class="rounded-md border border-ink-700 px-2.5 py-1 text-xs font-medium text-ink-200 transition hover:border-ink-600 hover:text-white"
        hreflang={otherLang === 'zh' ? 'zh-CN' : 'en-US'}
      >
        {otherLabel}
      </a>
      <BayjfLink size={18} class="hidden rounded-md px-2 py-1.5 text-xs font-medium text-ink-300 transition hover:text-white sm:inline-block" />
      <a
        href={SITE.repo}
        target="_blank"
        rel="noopener"
        class="hidden rounded-md border border-ink-700 px-3 py-1.5 text-xs font-medium text-ink-200 transition hover:border-ink-600 hover:text-white sm:inline-block"
      >
        GitHub
      </a>
      <a href="#download" class="btn-primary px-3 py-1.5 text-xs">{t(lang, 'nav.download')}</a>
    </div>
  </div>
</header>
