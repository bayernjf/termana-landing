---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../i18n/site';

const title = 'Terms of Service | termana';
const description = 'Terms of Service of termana: the agreement covering use of this site and its content.';
---

<Base title={title} description={description}>
  <Header />
  <main id="main" class="container-page py-20 sm:py-28">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">Legal</p>
      <h1 class="h2 mt-3">Terms of Service</h1>
      <p class="mt-3 text-sm text-ink-500">Last updated: August 7, 2026</p>

      <div class="mt-10 space-y-10 text-sm leading-7 text-ink-300">
        <section>
          <h2 class="text-lg font-semibold text-white">1. Acceptance</h2>
          <p class="mt-2">
            Welcome to the official website of termana (the "Site"), a local-first terminal project launcher for coding agents. By accessing or using the Site you agree to be bound by these terms. If you do not agree, please do not use the Site.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">2. Site Content</h2>
          <p class="mt-2">
            Content on the Site is provided "as is" for product introduction purposes and may change as the product evolves. We strive for accuracy but make no express or implied warranties regarding completeness or timeliness.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">3. Intellectual Property</h2>
          <p class="mt-2">
            The Site's copy, design, and branding belong to the project team and may not be used commercially without permission. The termana application and its source code are governed by the license declared in the repository.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">4. Acceptable Use</h2>
          <p class="mt-2">
            Do not use the Site in ways that could harm or disrupt its operation or infringe on others' rights, including malicious scraping, injection attacks, or impersonation of the Site or the project.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">5. Limitation of Liability</h2>
          <p class="mt-2">
            To the maximum extent permitted by law, the Site is not liable for any indirect, incidental, or consequential damages arising from use of or inability to use its content, including any software downloaded through links on the Site.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">6. Changes</h2>
          <p class="mt-2">
            These terms may be updated; changes will be posted on this page. Continued use of the Site constitutes acceptance of the updated terms.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">7. Contact</h2>
          <p class="mt-2">
            Questions can be raised via Issues on our
            <a href={SITE.repo} target="_blank" rel="noopener" class="font-medium text-accent transition hover:text-accent-soft">GitHub repository</a>.
          </p>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Base>
