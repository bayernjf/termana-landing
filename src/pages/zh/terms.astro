---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../i18n/site';

const title = '服务条款 | termana';
const description = 'termana 服务条款：使用本站与本站点内容的相关约定。';
---

<Base title={title} description={description}>
  <Header />
  <main id="main" class="container-page py-20 sm:py-28">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">Legal</p>
      <h1 class="h2 mt-3">服务条款</h1>
      <p class="mt-3 text-sm text-ink-500">最后更新：2026 年 8 月 7 日</p>

      <div class="mt-10 space-y-10 text-sm leading-7 text-ink-300">
        <section>
          <h2 class="text-lg font-semibold text-white">1. 接受条款</h2>
          <p class="mt-2">
            欢迎访问 termana 官方网站（下称「本站」）。访问或使用本站即表示你同意受本条款约束。如不同意，请停止使用本站。
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">2. 站点内容</h2>
          <p class="mt-2">
            本站内容为 termana 产品的介绍与说明，按「现状」提供，可能随产品迭代发生变化。我们努力保证信息准确，但不对内容的完整性、时效性作任何明示或暗示的保证。
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">3. 软件许可与知识产权</h2>
          <p class="mt-2">
            termana 应用的分发与使用以其发行版或仓库中声明的许可证为准。本站的文案、设计与标识归项目方所有，未经许可不得用于商业目的。
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">4. 合理使用</h2>
          <p class="mt-2">
            请勿以任何可能损害、干扰本站运行或侵犯他人权益的方式使用本站，包括但不限于恶意爬取、注入攻击或冒充本站身份。
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">5. 责任限制</h2>
          <p class="mt-2">
            在法律允许的最大范围内，本站与 termana 软件不对因使用或无法使用本站内容或软件而产生的任何间接、附带或后果性损失承担责任。
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-white">6. 条款变更与联系</h2>
          <p class="mt-2">
            本条款可能更新，变更将在本页发布。如有疑问，请通过
            <a href={SITE.repo} class="text-accent hover:underline">GitHub 仓库</a>
            的 Issues 与我们联系。
          </p>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Base>
